    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "@astra/config": "*",
    "prisma": "^7.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
