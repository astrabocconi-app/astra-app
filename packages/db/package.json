{
  "name": "@astra/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and the Neon client singleton for ASTRA",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
