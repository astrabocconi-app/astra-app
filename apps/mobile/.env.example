# =============================================================================
# apps/mobile — environment variables (Expo)
# Copy to `.env.local` and fill in. NEVER commit the real file.
# IMPORTANT: use `.env.local`, not `.env` — EAS Build loads `.env` into cloud
# builds (staging/production), so a `.env` here would bake this local override
# (e.g. a LAN dev URL) into the shipped app. `.env.local` is local-only by
# Expo's own convention and is never picked up by EAS Build.
#
# ⚠️  EXPO_PUBLIC_* variables are PUBLIC BY DEFINITION. They are inlined into the
#     JS bundle shipped to devices and can be read by anyone with the app.
#     NEVER put secrets here (no DB URL, no API secrets, no HMAC keys).
#     The Neon connection string must NOT exist in the mobile bundle.
# =============================================================================

# Base URL of the deployed apps/web instance the app talks to (dev override).
# Staging/production URLs are baked per EAS profile in app.config.ts.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Sentry DSN for the mobile app (a DSN is public — safe to expose; disabled in dev).
EXPO_PUBLIC_SENTRY_DSN="https://xxxx@oyyy.ingest.sentry.io/zzzz"

# Selects which API_URL app.config.ts uses: development | staging | production.
APP_ENV="development"
