// ASTRA — Prisma schema
//
// Connection strategy (Prisma 7 — see prisma.config.ts + docs/SETUP.md):
//   - Runtime client uses a DRIVER ADAPTER (@prisma/adapter-pg) built from
//     DATABASE_URL (Neon POOLED `-pooler` host). See packages/db/src/index.ts.
//   - Migrations/introspection use DIRECT_URL (Neon UNPOOLED host), configured
//     as the CLI `datasource` in prisma.config.ts.
//   Prisma 7 no longer allows `url`/`directUrl` inside the datasource block.
//
// DESIGN NOTES (see docs/ARCHITECTURE.md §"Data model"):
//   - Points are APPEND-ONLY. There is no mutable balance column anywhere.
//     Balances come from the `PointsBalance` SQL VIEW over PointsLedgerEntry.
//   - The ledger is made immutable by a Postgres trigger that blocks
//     UPDATE/DELETE. That trigger, the PointsBalance/MaterialStats views, and
//     the DiscountUsage generated column are not expressible in Prisma schema;
//     they are created by the init migration and documented in
//     packages/db/prisma/sql/0001_views_and_immutability.sql.
//   - Soft delete via `deletedAt`. Consent stored as text `policyVersion`.
//   - Better Auth's own tables (session/account/verification) are added in
//     Phase 2 via the Better Auth CLI; `User` below is intentionally
//     compatible with it (id/email/emailVerified/name/image/timestamps).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

/// Global roles. Area-scoped authority is expressed via AreaMembership.
enum Role {
  STUDENT
  STAFF // can operate scanners (event check-in, partner card scan)
  AREA_MANAGER // manages content within their areas
  ADMIN // full access
  PARTNER_MANAGER // external partner staff (limited)
}

/// Points "wallet". v1 uses a single spendable currency (POINTS); the enum
/// exists so PointsBalance can aggregate per (userId, kind) as designed.
enum PointsKind {
  POINTS
}

/// Where a ledger entry came from (for reporting; delta sign encodes earn/spend).
enum LedgerSource {
  SIGNUP
  EVENT_CHECKIN
  PARTNER_SCAN
  REWARD_REDEMPTION
  ADMIN_ADJUSTMENT
  OTHER
}

enum DiscountType {
  PERCENT
  FIXED
  FREEBIE
  OTHER
}

enum RsvpStatus {
  GOING
  WAITLIST
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  VOID
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum Platform {
  IOS
  ANDROID
}

// ============================================================================
// Identity & access
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  roles         Role[]    @default([STUDENT])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // relations
  areaMemberships   AreaMembership[]
  consents          Consent[]
  ledgerEntries     PointsLedgerEntry[]     @relation("LedgerOwner")
  grantedEntries    PointsLedgerEntry[]     @relation("LedgerGrantedBy")
  discountUsages    DiscountUsage[]
  rewardRedemptions RewardRedemption[]
  rsvps             Rsvp[]
  tickets           Ticket[]
  checkedInTickets  Ticket[]                @relation("TicketCheckedInBy")
  newsPosts         NewsPost[]
  pushTokens        PushToken[]
  materialAccesses  MaterialAccess[]
  auditLogs         AuditLog[]              @relation("AuditActor")
  partnerMembership PartnerMembership?
  academicProfile   StudentAcademicProfile?
  examRecords       ExamRecord[]
  supportMessages   SupportMessage[]
  pushCampaigns     PushCampaign[]          @relation("PushSender")
  contentEdits      AppContent[]            @relation("ContentEditor")

  // Better Auth (email-OTP). Managed by Better Auth via the Prisma client.
  sessions Session[]
  accounts Account[]

  @@index([deletedAt])
}

// ── Better Auth tables (email-OTP). Fields must match Better Auth's schema;
//    regenerate with `npx @better-auth/cli generate` if the auth config changes.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// An association sub-team / department. Content and authority are scoped to areas.
model Area {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships AreaMembership[]
  partners    Partner[]
  rewards     Reward[]
  events      Event[]
  newsPosts   NewsPost[]
  materials   Material[]
}

model AreaMembership {
  id        String   @id @default(cuid())
  userId    String
  areaId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
  @@index([areaId])
}

/// Consent history — one row per acceptance. Latest by acceptedAt is current.
model Consent {
  id            String   @id @default(cuid())
  userId        String
  policyVersion String
  acceptedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Academic identity — public catalogue selections + private student profile
// ============================================================================

/// A reviewed snapshot of public Bocconi programme/class metadata.
model AcademicCatalogue {
  id           String   @id
  academicYear String
  version      String   @unique
  sourceUrl    String
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())

  programmes AcademicProgramme[]
  courses    AcademicCourse[]
}

model AcademicProgramme {
  id            String  @id
  catalogueId   String
  code          String
  name          String
  level         String
  durationYears Int
  sourceUrl     String
  active        Boolean @default(true)
  legacy        Boolean @default(false)

  catalogue   AcademicCatalogue         @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  classGroups AcademicClassGroup[]
  tracks      AcademicTrack[]
  profiles    StudentAcademicProfile[]
  courseLinks AcademicCourseProgramme[]

  @@unique([catalogueId, code])
  @@index([catalogueId, active])
}

/// Scraped Bocconi course catalogue. Populated (~659 courses) but not yet read
/// by the app — the gradebook that consumes it is a later phase. Declared here
/// so the schema describes what the database actually contains; without it,
/// `prisma migrate dev` would generate a migration dropping these tables.
model AcademicCourse {
  id          String   @id
  catalogueId String
  code        String
  title       String
  language    String?
  sourceUrl   String
  retrievedAt DateTime

  catalogue   AcademicCatalogue         @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  programmes  AcademicCourseProgramme[]
  examRecords ExamRecord[]

  @@unique([catalogueId, code])
  @@index([catalogueId])
}

/// A course can sit in several programmes, carrying different credits in each.
model AcademicCourseProgramme {
  id          String  @id
  courseId    String
  programmeId String
  credits     Int
  semester    String?
  courseType  String?

  course    AcademicCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  programme AcademicProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([courseId, programmeId])
  @@index([programmeId])
}

enum ExamStatus {
  PLANNED
  PASSED
  FAILED
  REJECTED
}

/// Student gradebook. Table exists and is empty; no app code reads it yet.
/// Grade/credit/year invariants are enforced by CHECK constraints in SQL (see
/// the 20260731120000 and 20260801100000 migrations) rather than in Prisma.
model ExamRecord {
  id          String     @id
  userId      String
  courseId    String?
  customTitle String?
  credits     Int
  studyYear   Int
  semester    String?
  status      ExamStatus @default(PLANNED)
  grade       Int?
  lode        Boolean    @default(false)
  passFail    Boolean    @default(false)
  examDate    DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course AcademicCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, studyYear])
  @@index([courseId])
}

model AcademicClassGroup {
  id          String @id
  programmeId String
  code        String
  sourceUrl   String

  programme AcademicProgramme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  profiles  StudentAcademicProfile[]

  @@unique([programmeId, code])
  @@index([programmeId])
}

model AcademicTrack {
  id          String  @id
  programmeId String
  code        String
  name        String
  sourceUrl   String
  active      Boolean @default(true)

  programme AcademicProgramme        @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  profiles  StudentAcademicProfile[]

  @@unique([programmeId, code])
  @@index([programmeId, active])
}

/// Student-managed academic selection. Grades belong to the later gradebook phase.
model StudentAcademicProfile {
  userId       String   @id
  programmeId  String
  trackId      String?
  studyYear    Int
  classGroupId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme  AcademicProgramme   @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  track      AcademicTrack?      @relation(fields: [trackId], references: [id], onDelete: SetNull)
  classGroup AcademicClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  @@index([programmeId])
  @@index([trackId])
  @@index([classGroupId])
}

// ============================================================================
// Points — append-only ledger (NO balance column; balance = PointsBalance view)
// ============================================================================

model PointsLedgerEntry {
  id          String       @id @default(cuid())
  userId      String
  kind        PointsKind   @default(POINTS)
  delta       Int // positive = earn, negative = spend
  source      LedgerSource @default(OTHER)
  reason      String
  refType     String? // e.g. "Event", "Offer", "Reward", "Ticket"
  refId       String?
  /// Which partner offer this scan was for, when the venue runs more than one.
  /// RESTRICT, not SetNull: the ledger is append-only at the DB level, so a
  /// cascading null would fire the blocked-UPDATE trigger. Offers are only ever
  /// soft-deleted anyway.
  offerId     String?
  grantedById String? // admin/staff who created a manual entry, if any
  createdAt   DateTime     @default(now())

  user      User   @relation("LedgerOwner", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?  @relation("LedgerGrantedBy", fields: [grantedById], references: [id])
  offer     Offer? @relation(fields: [offerId], references: [id], onDelete: Restrict)

  // Immutability (block UPDATE/DELETE) is enforced by a DB trigger in the
  // raw-SQL migration — NOT by application code. See header notes.
  @@index([userId, kind])
  @@index([refType, refId])
  @@index([createdAt])
  @@index([offerId])
}

// ============================================================================
// Partners & offers
// ============================================================================

model Partner {
  id          String    @id @default(cuid())
  name        String
  description String?
  category    String?
  logoKey     String? // R2 object key
  address     String?
  latitude    Float?
  longitude   Float?
  areaId      String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  area        Area?               @relation(fields: [areaId], references: [id])
  offers      Offer[]
  memberships PartnerMembership[]

  @@index([active, deletedAt])
}

/// Links a login account to a Partner venue (its staff). Carries the venue
/// login code + password hash used by the in-app partner sign-in. A student
/// account never has one of these; a partner account always does.
model PartnerMembership {
  id           String   @id @default(cuid())
  userId       String   @unique
  partnerId    String
  loginCode    String   @unique // e.g. "casadimichele" — what staff type to sign in
  passwordHash String // scrypt hash (salt:hash); issued by ASTRA, not self-set
  /// Scan-only accounts reach the scanner and nothing else. Venues asked for
  /// this so floor staff can award points without seeing takings/analytics.
  scanOnly     Boolean  @default(false)
  /// Human label so a venue with several logins can tell them apart
  /// ("Front desk", "Bar"). Not used for authentication.
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model Offer {
  id            String       @id @default(cuid())
  partnerId     String
  title         String
  description   String?
  discountType  DiscountType @default(OTHER)
  discountValue Int? // percent (0-100) or fixed cents, depending on discountType
  pointsAwarded Int          @default(0) // points earned when this offer is used
  active        Boolean      @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  partner       Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  usages        DiscountUsage[]
  ledgerEntries PointsLedgerEntry[]

  @@index([partnerId, active])
}

/// One row per redemption. `usageDate` is a Postgres GENERATED column
/// (usedAt::date) — added in the raw-SQL migration — so the unique constraint
/// enforces "once per user per offer per day".
model DiscountUsage {
  id        String    @id @default(cuid())
  userId    String
  offerId   String
  usedAt    DateTime  @default(now())
  /// DB-generated STORED column (usedAt::date, UTC day). Prisma never writes it.
  /// Note: Postgres forbids STABLE functions in generated columns, so this is a
  /// UTC calendar day (not Rome-local). See prisma/sql/0001_views_and_immutability.sql.
  usageDate DateTime? @default(dbgenerated("(\"usedAt\")::date")) @db.Date

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId, usageDate])
  @@index([offerId])
}

// ============================================================================
// Rewards (spend points)
// ============================================================================

model Reward {
  id           String    @id @default(cuid())
  title        String
  description  String?
  imageKey     String? // R2 object key
  costPoints   Int
  stock        Int? // null = unlimited
  /// How many times ONE account may redeem this reward. null = no limit.
  /// Stops a single student farming free-ticket codes; stock caps the total
  /// across everyone, this caps it per person.
  perUserLimit Int?
  active       Boolean   @default(true)
  areaId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  area        Area?              @relation(fields: [areaId], references: [id])
  redemptions RewardRedemption[]
  codes       RewardCode[]

  @@index([active, deletedAt])
}

/// A pool of pre-issued vouchers for a reward — typically Eventbrite discount
/// codes for our own events. Each is handed to exactly one redemption, so a
/// single-use code can never be given to two students. Rewards without a pool
/// simply redeem to a PENDING redemption that staff fulfil by hand.
/// What a support message is about, so the backoffice can triage at a glance.
enum SupportKind {
  QUESTION
  ISSUE
  IDEA
}

enum SupportStatus {
  OPEN
  RESOLVED
}

/// A message sent from the app's support screen.
///
/// Always tied to the account that sent it — the whole point is being able to
/// write back, so the reporter's email comes from the User relation rather than
/// being retyped (and mistyped) into the form. The relation is RESTRICT rather
/// than CASCADE: if someone deletes their account we keep the thread, since it
/// may be mid-conversation. Account deletion anonymises the User row, so the
/// message survives without carrying personal data.
model SupportMessage {
  id        String        @id @default(cuid())
  userId    String
  kind      SupportKind   @default(QUESTION)
  message   String
  status    SupportStatus @default(OPEN)
  /// Free-text note for whoever handles it; never shown in the app.
  adminNote String?
  /// App version + platform, so a bug report has context without asking.
  appVersion String?
  platform   String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId])
}

model RewardCode {
  id           String    @id @default(cuid())
  rewardId     String
  code         String
  /// Set the moment it is handed out; NULL means still available.
  claimedAt    DateTime?
  redemptionId String?   @unique
  createdAt    DateTime  @default(now())

  /// Eventbrite discount id, when the code was generated through the API
  /// rather than pasted in by hand. Without it, removing an unused code would
  /// leave a live discount on Eventbrite that nothing points at any more.
  externalId      String? @unique
  /// The Eventbrite event the discount is scoped to.
  externalEventId String?

  reward     Reward            @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  redemption RewardRedemption? @relation(fields: [redemptionId], references: [id])

  @@unique([rewardId, code])
  @@index([rewardId, claimedAt])
}

model RewardRedemption {
  id            String           @id @default(cuid())
  userId        String
  rewardId      String
  costPoints    Int // snapshot of cost at redemption time
  status        RedemptionStatus @default(PENDING)
  code          String?          @unique // fulfillment/pickup code
  ledgerEntryId String?          @unique // the SPEND PointsLedgerEntry
  createdAt     DateTime         @default(now())
  fulfilledAt   DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     Reward      @relation(fields: [rewardId], references: [id])
  rewardCode RewardCode?

  @@index([userId])
  @@index([rewardId, status])
  /// Counting a student's prior redemptions is on the redeem path (perUserLimit).
  @@index([userId, rewardId])
}

// ============================================================================
// Events + tickets
// ============================================================================

model Event {
  id                String    @id @default(cuid())
  title             String
  description       String?
  coverImageKey     String?
  location          String?
  latitude          Float?
  longitude         Float?
  startsAt          DateTime
  endsAt            DateTime?
  externalTicketUrl String? // advertise-only: link out to where tickets are sold
  capacity          Int? // null = unlimited (legacy; unused in advertise-only v1)
  pointsOnCheckin   Int       @default(0) // legacy; unused in advertise-only v1
  /// Same shape as NewsPost.links — shown at the bottom of the event page.
  links             Json?
  areaId            String?
  published         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  area    Area?    @relation(fields: [areaId], references: [id])
  rsvps   Rsvp[]
  tickets Ticket[]

  @@index([published, startsAt])
}

model Rsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Ticket {
  id            String       @id @default(cuid())
  eventId       String
  userId        String
  code          String       @unique // opaque id embedded in the signed QR payload
  status        TicketStatus @default(VALID)
  checkedInAt   DateTime?
  checkedInById String?
  createdAt     DateTime     @default(now())

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedInBy User? @relation("TicketCheckedInBy", fields: [checkedInById], references: [id])

  @@unique([eventId, userId]) // one ticket per user per event
  @@index([status])
}

// ============================================================================
// News / announcements
// ============================================================================

model NewsPost {
  id            String    @id @default(cuid())
  title         String
  body          String // markdown/rich text
  excerpt       String?
  coverImageKey String?
  authorId      String?
  areaId        String?
  published     Boolean   @default(false)
  pinned        Boolean   @default(false)
  publishedAt   DateTime?
  /// Call-to-action links shown at the bottom of the article. Array of
  /// { label, kind: "external" | "internal", value } — see @astra/shared
  /// contentLinks. Internal links are in-app routes; external are https URLs.
  links         Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  author User? @relation(fields: [authorId], references: [id])
  area   Area? @relation(fields: [areaId], references: [id])

  @@index([published, pinned, publishedAt])
}

// Image bytes stored directly in Postgres (event/news/reward cover images).
// Served via GET /api/media/:id. Small pilot-scale assets only; can be swapped
// for Vercel Blob later without touching callers (they store /api/media/:id).
model ImageAsset {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  byteSize  Int
  createdAt DateTime @default(now())
}

// NOTE: the "Ask ASTRA" RAG knowledge base (the Document table + pgvector) has
// been SPLIT off this Neon app DB onto Supabase Postgres — see apps/web/lib/
// rag-db.ts + bocconi-scraper/pipeline. It's queried there via `pg`, not Prisma,
// so there is no Document model here anymore.

// ============================================================================
// Materials (files via R2). Per-user access is recorded privately; only the
// aggregate MaterialStats view is exposed (never per-user rows).
// ============================================================================

model Material {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileKey     String // R2 object key
  fileType    String?
  sizeBytes   Int?
  areaId      String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  area     Area?            @relation(fields: [areaId], references: [id])
  accesses MaterialAccess[]

  @@index([published, deletedAt])
}

model MaterialAccess {
  id         String   @id @default(cuid())
  materialId String
  userId     String?
  accessedAt DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([materialId])
}

// ============================================================================
// Push notifications & audit
// ============================================================================

/// Editable app content that is otherwise hardcoded in the mobile bundle.
///
/// One row per screen, keyed by name ("astraworld"). The payload is JSON in the
/// screen own shape rather than a generic block/field model: this exists so a
/// specific page can be corrected without shipping an App Store update, not as
/// a general CMS. The app keeps its bundled copy as a fallback, so a missing or
/// malformed row degrades to what was compiled in rather than an empty screen.
model AppContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("ContentEditor", fields: [updatedById], references: [id])
}

/// A push notification sent from the backoffice.
///
/// Kept as a record rather than fire-and-forget: it is the only way to answer
/// "what did we send, to whom, and when" after the fact, and it stops the same
/// announcement being sent twice by someone who was not sure it went.
model PushCampaign {
  id        String   @id @default(cuid())
  title     String
  body      String
  /// Optional in-app route to open when the notification is tapped.
  route     String?
  /// The audience filters used, so a send can be understood later.
  filters   Json
  /// Devices actually targeted (a user with no device is not counted).
  sentCount Int
  /// Distinct users the send reached.
  userCount Int
  sentById  String?
  createdAt DateTime @default(now())

  sentBy User? @relation("PushSender", fields: [sentById], references: [id])

  @@index([createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // Expo push token
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only audit trail of mutating admin/staff actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "reward.create", "points.adjust"
  targetType String?
  targetId   String?
  areaId     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
