{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "STORAGE_DATABASE_URL",
    "STORAGE_DATABASE_URL_UNPOOLED",
    "STORAGE_POSTGRES_URL",
    "STORAGE_POSTGRES_PRISMA_URL",
    "STORAGE_POSTGRES_URL_NON_POOLING",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CARD_TOKEN_HMAC_SECRET",
    "ALLOWED_EMAIL_DOMAINS",
    "MOBILE_ALLOWED_ORIGINS",
    "CRON_SECRET",
    "CHAT_ENABLED",
    "SIGNUP_TOMBSTONE_SECRET",
    "OPENAI_API_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_USER_2",
    "SMTP_PASS_2",
    "SUPABASE_URL",
    "SUPABASE_SECRET_KEY",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ],
  "tasks": {
    "@astra/db#generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "@astra/db#generate"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
