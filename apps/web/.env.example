# =============================================================================
# apps/web — environment variables (dashboard + API)
#
# Infra is managed by VERCEL. Don't hand-maintain this file — link the project
# and pull env locally:   vercel link   &&   vercel env pull apps/web/.env
# (see docs/SETUP.md). The vars below document what should exist; placeholders
# are only for someone running fully offline without Vercel.
# NEVER commit the real `.env`.
# =============================================================================

# --- Database (Neon, provisioned via Vercel → Storage) ----------------------
# Vercel's Neon integration auto-injects these. The app reads whichever exists:
#   POOLED  (runtime):    DATABASE_URL | POSTGRES_PRISMA_URL | POSTGRES_URL
#   DIRECT  (migrations): DIRECT_URL | DATABASE_URL_UNPOOLED | POSTGRES_URL_NON_POOLING
# Locally without Vercel you can set the two below directly.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/astra?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/astra?sslmode=require"

# --- Better Auth ------------------------------------------------------------
# Random 32+ byte secret. Generate: `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-me-openssl-rand-base64-32"
# Public base URL of THIS web app (used for auth callbacks). Dev: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (Resend) — delivers OTP codes ------------------------------------
# Install the Resend integration from the Vercel Marketplace (injects this),
# or set it manually from https://resend.com/api-keys. In local dev, leave a
# placeholder — the OTP code is printed to the server console instead.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# --- File storage (Vercel Blob) ---------------------------------------------
# Vercel dashboard → Storage → Blob. Auto-injected by Vercel; only needed once
# the Materials/News-image features land (Phase 9-10).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# --- Card / QR token signing ------------------------------------------------
# HMAC secret for signing scannable card tokens. Generate: `openssl rand -hex 32`.
CARD_TOKEN_HMAC_SECRET="replace-me-openssl-rand-hex-32"

# --- Observability (Sentry) -------------------------------------------------
# Sentry project → Settings → Client Keys (DSN).
SENTRY_DSN="https://xxxx@oyyy.ingest.sentry.io/zzzz"

# --- Auth policy ------------------------------------------------------------
# Comma-separated email domains allowed to request an OTP (validated server-side
# before send). Defaults to studbocconi.it,unibocconi.it if unset.
ALLOWED_EMAIL_DOMAINS="studbocconi.it,unibocconi.it"

# DEV-ONLY login bypass (POST /api/auth/dev-login). Auto-enabled when
# NODE_ENV !== "production" (i.e. local `next dev`); always OFF on Vercel deploys.
# Only force this on elsewhere if you understand the risk (no password on it).
# DEV_LOGIN_ENABLED="false"

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call /api/* (Expo dev client + prod app).
MOBILE_ALLOWED_ORIGINS="http://localhost:8081,exp://127.0.0.1:8081"
