# =============================================================================
# apps/web — environment variables (dashboard + API)
#
# Infra is managed by VERCEL. Don't hand-maintain this file — link the project
# and pull env locally:   vercel link   &&   vercel env pull apps/web/.env
# (see docs/SETUP.md). The vars below document what should exist; placeholders
# are only for someone running fully offline without Vercel.
# NEVER commit the real `.env`.
# =============================================================================

# --- Database (Neon, provisioned via Vercel → Storage) ----------------------
# Vercel's Neon integration auto-injects these. The app reads whichever exists:
#   POOLED  (runtime):    DATABASE_URL | POSTGRES_PRISMA_URL | POSTGRES_URL
#   DIRECT  (migrations): DIRECT_URL | DATABASE_URL_UNPOOLED | POSTGRES_URL_NON_POOLING
# Locally without Vercel you can set the two below directly.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/astra?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/astra?sslmode=require"

# --- Better Auth ------------------------------------------------------------
# Random 32+ byte secret. Generate: `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-me-openssl-rand-base64-32"
# Public base URL of THIS web app (used for auth callbacks). Dev: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# --- Email — delivers OTP codes ---------------------------------------------
# Delivery order: SMTP (if SMTP_* set) → Resend (if key set) → dev console.
# In local dev, leave everything as placeholders — the OTP code is printed to
# the server console instead of being emailed.
#
# Sender address, used by whichever transport is active. For SMTP it must be on
# the authenticated mailbox's domain; for Resend, on a verified domain.
EMAIL_FROM="ASTRA <noreply@yourdomain.it>"
#
# Option A — SMTP (e.g. Aruba). Aruba mailboxes: host smtps.aruba.it, port 465,
# SMTP_SECURE=true, user = the full email address, pass = the mailbox password.
SMTP_HOST="smtps.aruba.it"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@yourdomain.it"
SMTP_PASS="PLACEHOLDER_mailbox_password"
#
# Option B — Resend (alternative to SMTP). From the Vercel Marketplace or
# https://resend.com/api-keys. Only used if SMTP is NOT configured.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# --- Card / QR token signing ------------------------------------------------
# HMAC secret for signing scannable card tokens. Generate: `openssl rand -hex 32`.
CARD_TOKEN_HMAC_SECRET="replace-me-openssl-rand-hex-32"

# --- Scheduled jobs / hardening (see docs/SETUP.md) -------------------------
# Bearer secret Vercel Cron sends to /api/cron/*. `openssl rand -hex 32`.
CRON_SECRET="replace-me-openssl-rand-hex-32"
# Secret for the deleted-account sign-up tombstone. `openssl rand -hex 32`.
SIGNUP_TOMBSTONE_SECRET="replace-me-openssl-rand-hex-32"
# Turns /api/chat on. The app has no chat screen: leave off.
# CHAT_ENABLED="false"

# NOTE: do not paste production database URLs here. Use a Neon branch.
# Web has no server-side Sentry. EXPO_PUBLIC_SENTRY_DSN is a mobile (EAS) variable.

# --- Auth policy ------------------------------------------------------------
# Comma-separated email domains allowed to request an OTP (validated server-side
# before send). Defaults to studbocconi.it,unibocconi.it if unset.
ALLOWED_EMAIL_DOMAINS="studbocconi.it,unibocconi.it"

# DEV-ONLY login bypass (POST /api/auth/dev-login). Enabled only when
# NODE_ENV !== "production" AND DATABASE_URL points at a database on this machine
# (localhost); always OFF on Vercel deploys and against Neon. Only force it on
# elsewhere if you understand the risk (no password on it).
# DEV_LOGIN_ENABLED="false"

# --- ASTRA admin (single central 2FA login for the dashboard) ---------------
# One admin account controls all content. Sign-in = username + password + an
# OTP emailed via SMTP (above). Generate all three with:
#   node scripts/create-admin.mjs <username> <email> [password]
ADMIN_USERNAME="astra"
ADMIN_EMAIL="ops@astrabocconi.com"
ADMIN_PASSWORD_HASH="replace-me-run-scripts/create-admin.mjs"
# OTP second factor: defaults ON in production, OFF locally (usable without an
# inbox in dev). Force it either way with "true"/"false".
# ADMIN_2FA_ENABLED="true"

# --- Ask ASTRA (RAG chatbot) ------------------------------------------------
# OpenAI key for embeddings (text-embedding-3-small) + answers (gpt-4o-mini).
# Used by /api/chat and the bocconi-scraper ingest script.
OPENAI_API_KEY="sk-..."
# Min cosine similarity for a retrieved chunk to count as an answer (else the
# bot says "I don't know"). Default 0.3.
# RAG_MIN_SIMILARITY="0.3"

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call /api/* (Expo dev client + prod app).
MOBILE_ALLOWED_ORIGINS="http://localhost:8081,exp://127.0.0.1:8081"

# --- Operations -------------------------------------------------------------
# Daily cleanup cron (vercel.json -> /api/cron/cleanup). Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`; without it the route refuses everyone.
# CRON_SECRET above.
# Supabase (guides + handouts) and Eventbrite (ticket discounts) are optional:
# SUPABASE_URL, SUPABASE_SECRET_KEY, EVENTBRITE_PRIVATE_TOKEN, EVENTBRITE_ORG_ID.
# Students must pick a track where one is open for their year (BIEF, BGL, BIG,
# CLEACC...). Set "false" only while old app builds that never send one are live.
# ACADEMIC_TRACK_REQUIRED="true"
# The seed scripts refuse any non-local database; "1" overrides for a throwaway branch.
# ALLOW_REMOTE_SEED="1"
