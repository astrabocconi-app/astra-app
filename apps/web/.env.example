# =============================================================================
# apps/web — environment variables (dashboard + API)
# Copy to `.env` and fill in. NEVER commit the real `.env`. See docs/SETUP.md.
# All values below are PLACEHOLDERS.
# =============================================================================

# --- Database (Neon) --------------------------------------------------------
# POOLED connection (the `-pooler` host). Used by the app at runtime on Vercel.
# Plain unpooled connections exhaust under serverless concurrency. Get it from
# the Neon dashboard → your branch → "Connection string" → Pooled.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/astra?sslmode=require"

# UNPOOLED / direct connection. Used ONLY by `prisma migrate` & introspection.
# Neon dashboard → same branch → "Connection string" → Direct (no -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/astra?sslmode=require"

# --- Better Auth ------------------------------------------------------------
# Random 32+ byte secret. Generate: `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-me-openssl-rand-base64-32"
# Public base URL of THIS web app (used for auth callbacks). Dev: http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (Resend) — used to deliver OTP codes -----------------------------
# Resend dashboard → API Keys. https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# --- File storage (Cloudflare R2, via S3 SDK) -------------------------------
# Cloudflare dashboard → R2. Account ID is on the R2 overview page.
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET="astra-materials"

# --- Card / QR token signing ------------------------------------------------
# HMAC secret for signing scannable card tokens. Generate: `openssl rand -hex 32`.
CARD_TOKEN_HMAC_SECRET="replace-me-openssl-rand-hex-32"

# --- Observability (Sentry) -------------------------------------------------
# Sentry project → Settings → Client Keys (DSN).
SENTRY_DSN="https://xxxx@oyyy.ingest.sentry.io/zzzz"

# --- Auth policy ------------------------------------------------------------
# Only this email domain may request an OTP (validated server-side before send).
ALLOWED_EMAIL_DOMAIN="studbocconi.it"

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call /api/* (Expo dev client + prod app).
MOBILE_ALLOWED_ORIGINS="http://localhost:8081,exp://127.0.0.1:8081"
